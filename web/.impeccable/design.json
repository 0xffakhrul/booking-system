  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The 48px full-width main action at the thumb; one per screen.",
      "html": "<button class=\"ds-btn-primary\">Continue</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:48px;width:100%;border:0;border-radius:6px;background:var(--primary,#1556e0);color:var(--primary-foreground,#fff);font-family:'Onest Variable',system-ui,sans-serif;font-size:15px;font-weight:600;box-shadow:0 1px 2px rgba(13,58,158,.25);cursor:pointer;transition:background-color 150ms}.ds-btn-primary:hover{background:var(--primary-hover,#0f47bf)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(21 86 224 / .5)}.ds-btn-primary:disabled{background:var(--muted,#f1f1f1);color:var(--muted-foreground,#5c5c5c);box-shadow:none;cursor:default}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White 48px companion action, e.g. Book another.",
      "html": "<button class=\"ds-btn-secondary\">Book another</button>",
      "css": ".ds-btn-secondary{height:48px;width:100%;border:0;border-radius:6px;background:var(--card,#fff);color:var(--foreground,#0a0a0a);font-family:'Onest Variable',system-ui,sans-serif;font-size:15px;font-weight:600;box-shadow:inset 0 0 0 1px var(--input,#d6d6d6);cursor:pointer;transition:background-color 150ms}.ds-btn-secondary:hover{background:var(--muted,#f1f1f1)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--input,#d6d6d6),0 0 0 3px rgb(21 86 224 / .4)}"
    },
    {
      "name": "Option Tile",
      "kind": "card",
      "refersTo": "option-tile",
      "description": "Radio tile for a service or a nearest free time; selected is tint plus 2px blue inset edge.",
      "html": "<div class=\"ds-tiles\"><button class=\"ds-tile\" aria-checked=\"true\"><span><b>Haircut</b><small><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>30 min</small></span><b>RM 28</b></button><button class=\"ds-tile\" aria-checked=\"false\"><span><b>Beard trim</b><small><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>15 min</small></span><b>RM 12</b></button></div>",
      "css": ".ds-tiles{display:flex;flex-direction:column;gap:8px;width:300px}.ds-tile{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 14px;border:0;border-radius:6px;background:var(--card,#fff);color:var(--foreground,#0a0a0a);font-family:'Onest Variable',system-ui,sans-serif;text-align:left;cursor:pointer;box-shadow:inset 0 0 0 1px var(--border,#e8e8e8);transition:background-color 150ms,box-shadow 150ms}.ds-tile span{display:flex;flex-direction:column;gap:2px}.ds-tile b{font-size:15px;font-weight:600}.ds-tile small{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted-foreground,#5c5c5c)}.ds-tile:hover{box-shadow:inset 0 0 0 1px var(--input,#d6d6d6)}.ds-tile[aria-checked=true]{background:var(--accent,#eef4ff);box-shadow:inset 0 0 0 2px var(--primary,#1556e0)}.ds-tile:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--border,#e8e8e8),0 0 0 3px rgb(21 86 224 / .4)}"
    },
    {
      "name": "Segmented Control",
      "kind": "nav",
      "refersTo": "segmented-control",
      "description": "Staff choice: Anyone or one named person; wraps when crowded.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button aria-checked=\"true\">Anyone</button><button aria-checked=\"false\">Ali</button><button aria-checked=\"false\">Siti</button></div>",
      "css": ".ds-seg{display:flex;flex-wrap:wrap;gap:2px;padding:3px;border-radius:6px;background:var(--muted,#f1f1f1);width:280px}.ds-seg button{flex:1 0 auto;min-width:64px;height:44px;padding:0 12px;border:0;border-radius:4px;background:transparent;font-family:'Onest Variable',system-ui,sans-serif;font-size:13px;font-weight:500;color:rgb(10 10 10 / .75);cursor:pointer;transition:background-color 150ms,box-shadow 150ms}.ds-seg button:hover{color:var(--foreground,#0a0a0a)}.ds-seg button[aria-checked=true]{background:var(--card,#fff);color:var(--foreground,#0a0a0a);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08),0 0 0 1px rgba(0,0,0,.04)}.ds-seg button:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(21 86 224 / .4)}"
    },
    {
      "name": "Time Slots",
      "kind": "chip",
      "refersTo": "time-slot",
      "description": "Phone grid of free times; picked slot is solid blue.",
      "html": "<div class=\"ds-slots\"><button>12:00 PM</button><button aria-checked=\"true\">12:30 PM</button><button>1:00 PM</button><button>1:30 PM</button><button>2:00 PM</button><button>2:30 PM</button></div>",
      "css": ".ds-slots{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:300px}.ds-slots button{height:44px;border:0;border-radius:6px;background:var(--card,#fff);color:var(--foreground,#0a0a0a);font-family:'Onest Variable',system-ui,sans-serif;font-size:14px;font-weight:500;white-space:nowrap;cursor:pointer;box-shadow:inset 0 0 0 1px var(--border,#e8e8e8);transition:background-color 150ms,box-shadow 150ms,color 150ms}.ds-slots button:hover{box-shadow:inset 0 0 0 1px var(--primary,#1556e0)}.ds-slots button[aria-checked=true]{background:var(--primary,#1556e0);color:var(--primary-foreground,#fff);font-weight:600;box-shadow:none}.ds-slots button:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(21 86 224 / .4)}"
    },
    {
      "name": "Split Continue Row",
      "kind": "custom",
      "refersTo": "time-slot-picked-list",
      "description": "Desktop time list: the picked time splits into tinted time plus blue Continue that slides in.",
      "html": "<div class=\"ds-split\"><button class=\"ds-split-time\">2:00 PM</button><button class=\"ds-split-go\">Continue</button></div>",
      "css": ".ds-split{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:252px;font-family:'Onest Variable',system-ui,sans-serif}.ds-split button{height:44px;border:0;border-radius:6px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}.ds-split-time{background:var(--accent,#eef4ff);color:var(--accent-foreground,#0d3a9e);box-shadow:inset 0 0 0 1px var(--accent-border,#c9daff)}.ds-split-go{background:var(--primary,#1556e0);color:var(--primary-foreground,#fff);animation:ds-slide 200ms ease-out}.ds-split-go:hover{background:var(--primary-hover,#0f47bf)}.ds-split button:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(21 86 224 / .4)}@keyframes ds-slide{from{opacity:0;transform:translateX(-8px)}}@media (prefers-reduced-motion:reduce){.ds-split-go{animation:none}}"
    },
    {
      "name": "Month Calendar Days",
      "kind": "custom",
      "refersTo": "calendar-day-bookable",
      "description": "Desktop calendar: bookable days tinted, selected solid blue, today dotted, outside window disabled.",
      "html": "<div class=\"ds-cal\"><button disabled>7</button><button disabled>8</button><button class=\"today\">9</button><button>10</button><button aria-checked=\"true\">11</button><button>12</button><button>13</button></div>",
      "css": ".ds-cal{display:grid;grid-template-columns:repeat(7,48px);gap:6px}.ds-cal button{position:relative;aspect-ratio:1;border:0;border-radius:6px;background:var(--accent,#eef4ff);color:var(--accent-foreground,#0d3a9e);font-family:'Onest Variable',system-ui,sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:background-color 150ms,box-shadow 150ms}.ds-cal button:hover{box-shadow:inset 0 0 0 1px var(--accent-border,#c9daff)}.ds-cal button[aria-checked=true]{background:var(--primary,#1556e0);color:var(--primary-foreground,#fff)}.ds-cal button:disabled{background:transparent;color:var(--muted-foreground,#5c5c5c);font-weight:500;cursor:default;box-shadow:none}.ds-cal .today::after{content:'';position:absolute;bottom:6px;left:50%;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:currentColor}.ds-cal button:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(21 86 224 / .4)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "46px input with label above and hint below; blue focus and caret.",
      "html": "<label class=\"ds-field\"><span>Phone number</span><input type=\"tel\" placeholder=\"012-345 6789\"><small>The shop uses this if they need to reach you.</small></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;width:300px;font-family:'Onest Variable',system-ui,sans-serif}.ds-field span{font-size:14px;font-weight:500;color:var(--foreground,#0a0a0a)}.ds-field input{height:46px;padding:0 14px;border:1px solid var(--input,#d6d6d6);border-radius:6px;background:var(--card,#fff);font:inherit;font-size:15px;color:var(--foreground,#0a0a0a);caret-color:var(--primary,#1556e0);outline:none;transition:border-color 150ms,box-shadow 150ms}.ds-field input::placeholder{color:var(--muted-foreground,#5c5c5c)}.ds-field input:focus-visible{border-color:var(--primary,#1556e0);box-shadow:0 0 0 3px rgb(21 86 224 / .5)}.ds-field small{font-size:13px;color:var(--muted-foreground,#5c5c5c)}"
    },
    {
      "name": "Slot-taken Alert",
      "kind": "card",
      "refersTo": "alert-taken",
      "description": "The calm red notice when someone booked the time first.",
      "html": "<div class=\"ds-taken\" role=\"alert\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"/></svg><div><p class=\"h\">2:00 PM was just booked</p><p>Someone got it a moment before you. Your name and phone are saved, so just pick another time.</p></div></div>",
      "css": ".ds-taken{display:flex;align-items:flex-start;gap:12px;max-width:400px;padding:16px;border:1px solid var(--destructive-border,#f6cfca);border-radius:8.4px;background:var(--destructive-tint,#fef3f2);font-family:'Onest Variable',system-ui,sans-serif}.ds-taken svg{flex-shrink:0;margin-top:1px;color:var(--destructive,#b42318)}.ds-taken p{margin:0;font-size:14px;line-height:1.375;color:rgb(10 10 10 / .8)}.ds-taken .h{margin-bottom:4px;font-size:15px;font-weight:600;color:var(--destructive,#b42318)}"
    },
    {
      "name": "Confirmation Ticket",
      "kind": "card",
      "refersTo": "panel",
      "description": "Booked ticket: mono ref over a dashed perforation, then receipt rows.",
      "html": "<div class=\"ds-ticket\"><div class=\"ref\"><span>Booking ref</span><code>TMP-7K2Q</code></div><dl><div><dt>When</dt><dd>Fri 13 Nov, 2:00 to 2:30 PM</dd></div><div><dt>With</dt><dd>Ali</dd></div><div><dt>Price</dt><dd>RM 28 · pay at the shop</dd></div></dl></div>",
