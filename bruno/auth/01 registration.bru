meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "businessName": "Kedai Gunting {{runId}}",
    "slug": "{{slug}}",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const id = Date.now();
  bru.setVar("runId", id);
  bru.setVar("email", `owner${id}@example.com`);
  bru.setVar("slug", `shop-${id}`);
}

tests {
  test("201 created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the user without password hash", function () {
    const user = res.getBody().user;
    expect(user.email).to.equal(bru.getVar("email"));
    expect(user.id).to.be.a("string");
    expect(user.role).to.equal("owner");
    expect(user).to.not.have.property("passwordHash");
  });

  test("returns the new business", function () {
    const { user, tenant } = res.getBody();
    expect(tenant.slug).to.equal(bru.getVar("slug"));
    expect(tenant.timezone).to.equal("Asia/Kuala_Lumpur");
    expect(user.tenantId).to.equal(tenant.id);
  });

  test("sets an HttpOnly session cookie", function () {
    const cookie = [].concat(res.getHeader("set-cookie") || []).join(";");
    expect(cookie).to.include("sid=");
    expect(cookie).to.include("HttpOnly");
    expect(cookie).to.include("SameSite=Lax");
  });
}
