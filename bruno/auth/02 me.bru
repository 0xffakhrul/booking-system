meta {
  name: Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

tests {
  test("200 and correct user", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.email).to.equal(bru.getVar("email"));
  });

  test("includes the user's business", function () {
    const { user, tenant } = res.getBody();
    expect(tenant.id).to.equal(user.tenantId);
    expect(tenant.slug).to.equal(bru.getVar("slug"));
  });
}
